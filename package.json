{
  "name": "teamflow",
  "version": "1.0.0",
  "private": true,
  "description": "Full-Stack Team and Project Management System",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:server": "npm run dev --workspace=backend",
    "dev:client": "npm run dev --workspace=frontend",
    "migrate": "node database/migrate.js",
    "seed": "node database/seed.js",
    "test": "npm run test --workspace=backend",
    "test:backend": "npm run test --workspace=backend",
    "test:frontend": "npm run test --workspace=frontend",
    "test:all": "npm run test --workspace=backend && npm run test --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "backup": "npm run backup --workspace=backend",
    "restore": "npm run restore --workspace=backend --"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
