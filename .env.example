# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Database
DATABASE_PATH=./src/db/teamflow.db

# Authentication
JWT_SECRET=super-secret-development-key-change-in-production-min-32-chars-long
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false

# Backups
BACKUP_DIR=./backups
BACKUP_KEEP=14
